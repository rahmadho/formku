{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ES2022",
		"moduleResolution": "bundler",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"types": ["node"],
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"allowJs": true,
		"checkJs": false,
		"isolatedModules": true,
		"verbatimModuleSyntax": false,
		"noEmit": true,
		"baseUrl": ".",
		"paths": {
			"$lib": ["./src/lib"],
			"$lib/*": ["./src/lib/*"],
			"./$types": ["./.svelte-kit/types/src/routes/*/"],
			"./$types.js": ["./.svelte-kit/types/src/routes/*/"]
		}
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.svelte",
		".svelte-kit/types/**/*.d.ts",
		"tests/**/*.ts",
		"vite.config.ts"
	],
	"exclude": ["node_modules", "build", ".svelte-kit/output"]
}
